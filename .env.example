# ============================================
# تنظیمات ربات Foxora2 (سروش پلاس)
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
# ============================================

# --- شناسهٔ مستقل این ربات (Foxora2) ---
# داده‌ها، دیتابیس، لاگ‌ها و تنظیمات در ~/.foxora2 ذخیره می‌شوند
# و هیچ اشتراکی با ربات‌های دیگر (Foxora یا B2) ندارند.
BOT_INSTANCE=foxora2

# --- نشست اختصاصی Foxora2 (روش اصلی: SPlusthon / یوزر-بات) ---
# یک رشتهٔ طولانی که با ابزار زیر یک‌بار ساخته و فقط در همین متغیر ذخیره می‌شود:
#   python3 tools/login_primary_once.py
# ⚠️ حتماً از حساب سروش جدا از ربات Foxora و B2 استفاده کنید.
SOROUSH_SESSION_STRING_FOXORA2=

# (اختیاری) API_ID و API_HASH اختصاصی Foxora2 یا عمومی
API_ID_FOXORA2=
API_HASH_FOXORA2=
API_ID=
API_HASH=

# --- روش جایگزین: ربات رسمی (Bot API از طریق @MrBot) ---
BOT_TOKEN_FOXORA2=
SOROUSH_BOT_TOKEN_FOXORA2=

# --- مسیر دادهٔ اختصاصی (اختیاری؛ پیش‌فرض: ~/.foxora2) ---
# SOROUSH_BOT_DATA_DIR_FOXORA2=/custom/path/for/foxora2
