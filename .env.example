# ============================================
# تنظیمات ربات Foxora2 (سروش پلاس)
# این فایل را به .env کپی کنید و مقادیر را پر کنید:
#   cp .env.example .env
# ============================================

# --- شناسهٔ مستقل این ربات (Foxora2) ---
# داده‌ها، دیتابیس، لاگ‌ها و تنظیمات در ~/.foxora2 ذخیره می‌شوند
# و هیچ اشتراکی با ربات‌های دیگر (Foxora یا B2) ندارند.
BOT_INSTANCE=foxora2

# --- نشست اختصاصی Foxora2 (روش اصلی: SPlusthon / یوزر-بات) ---
# یک رشتهٔ طولانی که با ابزار زیر یک‌بار ساخته و فقط در همین متغیر ذخیره می‌شود:
#   python3 tools/login_primary_once.py
# ⚠️ حتماً از حساب سروش جدا از ربات Foxora و B2 استفاده کنید.
SOROUSH_SESSION_STRING_FOXORA2=

# (اختیاری) کتابخانهٔ SPlusthon به‌طور پیش‌فرض مقادیر رسمی کلاینت سروش‌پلاس را در
# SoroushClient(StringSession()) دارد و نیازی به وارد کردن دستی API_ID و API_HASH نیست.
# تنها در صورت نیاز به override سفارشی، هر دو متغیر زیر را با هم مقداردهی کنید:
# API_ID_FOXORA2=
# API_HASH_FOXORA2=

# --- روش جایگزین: ربات رسمی (Bot API از طریق @MrBot) ---
BOT_TOKEN_FOXORA2=
SOROUSH_BOT_TOKEN_FOXORA2=

# --- مسیر دادهٔ اختصاصی (اختیاری؛ پیش‌فرض: ~/.foxora2) ---
# SOROUSH_BOT_DATA_DIR_FOXORA2=/custom/path/for/foxora2

# --- 🖇 فیلتر لینک بیوگرافی (اختیاری؛ هیچ‌کدام اجباری نیست) ---
# مستندات کامل: docs/BIO_LINK_FILTER.md
# پیش‌فرض گروه‌های بدون تنظیم: روشن. برای خاموش کردن پیش‌فرض مقدار 0 بگذارید.
# BIO_LINK_DEFAULT_ENABLED=1
# آیا «@username» تنها در بیو هم لینک حساب شود؟ (پیش‌فرض: خیر)
# BIO_LINK_DETECT_USERNAME=0
# فاصلهٔ تازه‌سازی وضعیت هر کاربر (ثانیه) و فاصلهٔ دورهای اسکن
# BIO_LINK_TTL_SECONDS=21600
# BIO_LINK_SCAN_INTERVAL=21600
# سقف اعضا در هر دور اسکن + بودجهٔ زمانی + فاصلهٔ بین درخواست‌ها
# BIO_LINK_SCAN_LIMIT=200
# BIO_LINK_SCAN_BUDGET=120
# BIO_LINK_RPC_DELAY=0.4
# BIO_LINK_FETCH_TIMEOUT=20
# BIO_LINK_START_DELAY=120
# BIO_LINK_CHECK_ON_MESSAGE=1
# اولین پیام هر کاربر منتظر بررسی بیو بماند؟ (پیش‌فرض: بله) + سقف انتظار
# BIO_LINK_AWAIT_FIRST_CHECK=1
# BIO_LINK_AWAIT_TIMEOUT=8
# اسکن دوره‌ای «همهٔ اعضا» — پیش‌فرض خاموش؛ فقط کاربران پیام‌دهنده بررسی می‌شوند
# BIO_LINK_AUTO_SCAN_MEMBERS=0
# BIO_LINK_CHECK_ON_JOIN=1
# BIO_LINK_MAX_PENDING=400
