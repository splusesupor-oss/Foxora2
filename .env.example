# Session credentials are secrets. Keep real values in a private environment or secret store.
# Prefer a private SQLite session path; use StringSession only if its value is protected.
SOROUSH_SESSION_PATH=./data/soroush
SOROUSH_SESSION_STRING=
# Optional overrides. SPlusthon 1.1.x has its own defaults; set BOTH only when needed.
# SOROUSH_API_ID=
# SOROUSH_API_HASH=

# Canonical authorization/config files and persistent runtime data.
# Only allowlisted, non-secret moderation keys are read; env values override JSON.
FOX_CONFIG_FILE=./config/config.json
FOX_OWNER_FILE=./config/owner.json
# Optional operator-supplied IDs; unset disables the special owner-silver bonus.
# This setting is environment-only and is deliberately not read from JSON config.
FOX_OWNER_SILVER_GROUP_IDS=
FOX_GLOBAL_WORDS_FILE=./config/banned_words.txt
# Optional read-only migration source for existing ID/username group-admin records.
FOX_LEGACY_ADMINS_FILE=./config/admins.json
# Member scans accept page sizes from 1 through 1000.
FOX_MEMBER_PAGE_SIZE=100
FOX_BOT_DATA_DIR=./data
FOX_BOT_DB=./data/foxbot.sqlite3
# Optional path for the typed, bounded local economy settings file.
# FOX_ECONOMY_SETTINGS_FILE=./config/economy_settings.json

# Source-compatible moderation toggles. Forward checks default off in the audited config.
FOX_CHECK_LINKS=true
FOX_DELETE_SPAM=true
FOX_CHECK_BANNED_WORDS=true
# Sender ad-name screening uses only the approved global word file, not source-only terms.
FOX_CHECK_AD_NAMES=true
FOX_HOT_RELOAD_BANNED_WORDS=true
FOX_CHECK_PHONE_NUMBERS=true
FOX_CHECK_USERNAMES=true
FOX_CHECK_FORWARDED=false
FOX_SEND_SPAM_WARNINGS=true
# Optional template fields: {username}, {reason}, {count}, {threshold}.
# FOX_WARNING_MESSAGE=
FOX_SPAM_THRESHOLD=5
FOX_ACTION_ON_THRESHOLD=ban
FOX_ACTION_DURATION_SECONDS=3600
# External name-family learning only promotes answers after these distinct-sample thresholds.
FOX_NAME_FAMILY_MIN_OBSERVATIONS=5
FOX_NAME_FAMILY_MIN_UNIQUE_USERS=3
FOX_NAME_FAMILY_MIN_UNIQUE_CHATS=2

# Optional duration for manual mute workflows; leave blank for platform-default behavior.
# FOX_MUTE_DURATION_SECONDS=

# One outbound bot RPC at a time, with a bounded fair queue and inter-call pacing.
# Accepted bounds: total pending 1-4096, per group 1-256, pacing 0-60 seconds.
RPC_MAX_PENDING_TOTAL=256
RPC_MAX_PENDING_PER_GROUP=32
RPC_MIN_INTERVAL_SECONDS=0.25
